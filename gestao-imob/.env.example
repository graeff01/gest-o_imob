# Banco de dados
DATABASE_URL="postgresql://user:password@host:port/database"

# Autenticacao
AUTH_SECRET="gere-um-segredo-forte"
AUTH_URL="http://localhost:3000"

# Identidade visual do ambiente: production | homologacao | local
NEXT_PUBLIC_APP_ENV=local
APP_ENV=local

# Perfis de acesso
AUTH_ADMIN_NAME="Admin Master"
AUTH_ADMIN_EMAIL="admin@example.com"
AUTH_ADMIN_HASH="hash-bcrypt-aqui"

AUTH_OWNER_1_NAME="Usuario Operacional 1"
AUTH_OWNER_1_EMAIL="owner1@example.com"
AUTH_OWNER_1_HASH="hash-bcrypt-aqui"

AUTH_OWNER_2_NAME="Usuario Operacional 2"
AUTH_OWNER_2_EMAIL="owner2@example.com"
AUTH_OWNER_2_HASH="hash-bcrypt-aqui"

# Seed opcional de banco
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="troque-esta-senha"

# Fallbacks mock devem ficar false fora do ambiente local.
ALLOW_MOCK_FALLBACKS=false

# Central IA
OPENAI_API_KEY=""

# Gateway NFS-e
GATEWAY_STUB_MODE=true
NFSE_GATEWAY_PROVIDER=nfeio
NFSE_GATEWAY_API_KEY=""
NFSE_COMPANY_ID=""
NFSE_COMPANY_CNPJ=""
NFSE_COMPANY_IM=""
NFSE_CITY_CODE=""
NFSE_SERVICE_CODE=""
NFSE_SERVICE_CODE_COMPLEMENT=""
NFSE_DEFAULT_ALIQUOTA=""
NFSE_HOMOLOGACAO=true

# Webhook NFE.io
NFEIO_WEBHOOK_SECRET=""
