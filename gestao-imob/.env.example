# ─── Banco de dados (Railway PostgreSQL) ──────────────────────────────────────
DATABASE_URL="postgresql://user:password@host:port/database"

# ─── NextAuth.js ───────────────────────────────────────────────────────────────
AUTH_SECRET="gerar-com: openssl rand -base64 32"
AUTH_URL="http://localhost:3000"

# Identidade visual do ambiente no front-end: production | homologacao | homolog | hml | local
NEXT_PUBLIC_APP_ENV=local

# Perfis de acesso
# ADMIN_MASTER: perfil tecnico. Acessa saude do sistema, auditoria, riscos e configuracoes.
# DONO: perfil operacional. Gerencia o sistema e emite notas, sem acesso tecnico.
AUTH_ADMIN_NAME="Admin Master"
AUTH_ADMIN_EMAIL="admin@moinhos.com"
AUTH_ADMIN_HASH="hash-bcrypt-aqui"

AUTH_OWNER_1_NAME="Dono 1"
AUTH_OWNER_1_EMAIL="dono1@moinhos.com"
AUTH_OWNER_1_HASH="hash-bcrypt-aqui"

AUTH_OWNER_2_NAME="Dono 2"
AUTH_OWNER_2_EMAIL="dono2@moinhos.com"
AUTH_OWNER_2_HASH="hash-bcrypt-aqui"

# Fallbacks mock foram removidos do fluxo operacional. Mantenha false.
ALLOW_MOCK_FALLBACKS=false

# ─── OpenAI (Central IA — OCR e classificação de documentos) ──────────────────
# Sem esta chave a Central IA deve retornar erro controlado, sem simular lancamento real.
OPENAI_API_KEY=""

# ─── Gateway NFS-e (nfse.io) ──────────────────────────────────────────────────
#
# PASSO A PASSO PARA ATIVAR:
#
# 1. Crie conta em https://nfse.io
# 2. Vá em "Empresas" → "Adicionar Empresa" → informe CNPJ e Inscrição Municipal
# 3. Faça upload do certificado A1 (.pfx) e a senha dele
# 4. Copie a API Key em "Configurações" → "API"
# 5. Copie o Company ID na página da empresa
# 6. Preencha as variáveis abaixo e mude GATEWAY_STUB_MODE para false
#
# HOMOLOGAÇÃO: mude NFSE_HOMOLOGACAO=true para testar sem emitir nota real
#

# false = emite de verdade | true = modo desenvolvimento (padrão)
GATEWAY_STUB_MODE=true

# nfseio (principal) | nfeio (alternativa)
NFSE_GATEWAY_PROVIDER=nfseio

# Obtido no painel do nfse.io após criar a conta
NFSE_GATEWAY_API_KEY=""

# ID da empresa no painel do nfse.io
NFSE_COMPANY_ID=""

# CNPJ da imobiliária (com ou sem pontuação)
NFSE_COMPANY_CNPJ=""

# Inscrição Municipal em Porto Alegre (verificar no alvará ou portal da prefeitura)
NFSE_COMPANY_IM=""

# Código IBGE de Porto Alegre — NÃO ALTERAR
NFSE_CITY_CODE=4314902

# Código de tributação nacional para intermediação imobiliária — NÃO ALTERAR
NFSE_SERVICE_CODE=10.05.01

# Código complementar municipal Porto Alegre — NÃO ALTERAR
NFSE_SERVICE_CODE_COMPLEMENT=10.05.01.002

# Alíquota padrão do Simples Nacional (% inteiro, ex: 9.0)
# Confirmar com o contador — pode variar conforme faixa de receita
NFSE_DEFAULT_ALIQUOTA=9.0

# true = aponta para sandbox do gateway (testes sem emitir nota real na prefeitura)
NFSE_HOMOLOGACAO=false
